<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AssemblyName>InterprocessMemory</AssemblyName>
    <RootNamespace>InterprocessMemory</RootNamespace>
    <DocumentationFile>..\bin\$(Configuration)\$(TargetFramework)\InterprocessMemory.xml</DocumentationFile>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Company>InterprocessMemory</Company>
    <Authors>zacala1</Authors>
    <Copyright>Copyright (c) 2024 zacala1</Copyright>

    <!-- NuGet Package Properties -->
    <PackageId>InterprocessMemory</PackageId>
    <Version>3.0.0</Version>
    <Title>InterprocessMemory</Title>
    <Description>Typed queues, messages, arrays, structured data, and raw memory shared safely between .NET processes.</Description>
    <PackageTags>shared-memory;ipc;high-performance;simd;lock-free;zero-allocation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/zacala1/InterprocessMemory</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zacala1/InterprocessMemory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>Version 3 introduces the InterprocessMemory namespace, factory-based creation, typed queues, explicit byte-stream/message APIs, and a new incompatible memory format.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\MIGRATION.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
